# Database Configuration
# Copy this file to .env and fill in actual values
DB_SERVER=db
DB_NAME=170171
DB_USER=sa
DB_PASSWORD=

# JWT Configuration
# Generate a secure random string (minimum 32 characters)
JWT_KEY=
JWT_ISSUER=localhost
JWT_AUDIENCE=localhost

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=user
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUALHOST=/
RABBITMQ_PORT=5672

# PayPal Configuration (nested config using double underscore __)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=

# Facebook OAuth Configuration
# App ID i App Secret sa developers.facebook.com (Settings -> Basic).
# Adrese Graph API-ja se ne unose - server ih ima ugradjene.
# Prihvata se i oblik Facebook__AppId / Facebook__AppSecret.
# Detaljna uputa: docs/prijava-google-facebook.md
FacebookAppId=
FacebookAppSecret=

# Google OAuth Configuration (nested config using double underscore __)
# ClientId je *web* client ID iz Google Cloud Console i mora biti ista vrijednost
# koju mobilna aplikacija dobija kroz --dart-define=GOOGLE_SERVER_CLIENT_ID.
# ClientSecret se ne koristi za provjeru tokena i moze ostati prazan.
Google__ClientId=
Google__ClientSecret=
