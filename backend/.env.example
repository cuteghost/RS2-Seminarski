# Database Configuration
# Copy this file to .env and fill in actual values
DB_SERVER=db
DB_NAME=170171
DB_USER=sa
DB_PASSWORD=

# JWT Configuration
# Generate a secure random string (minimum 32 characters)
JWT_KEY=
JWT_ISSUER=localhost
JWT_AUDIENCE=localhost

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=user
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUALHOST=/
RABBITMQ_PORT=5672

# PayPal Configuration (nested config using double underscore __)
PayPalOptions__ClientId=
PayPalOptions__ClientSecret=
PayPalOptions__Mode=Sandbox

# Facebook OAuth Configuration
FacebookAppId=
FacebookAppSecret=
Facebook__AppId=
Facebook__AppSecret=

# Google OAuth Configuration (nested config using double underscore __)
Google__ClientId=
Google__ClientSecret=
